{
  "name": "qudtlib-js-i18n",
  "version": "0.2.0",
  "author": "Florian JEANNE (https://github.com/florianjea/)",
  "homepage": "https://github.com/florianjea/qudtlib-js-i18n",
  "repository": "https://github.com/florianjea/qudtlib-js-i18n",
  "description": "Multilingual labels extension for @qudtlib/allunits",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src/labels.ts"
  ],
  "scripts": {
    "generate": "tsx --tsconfig tsconfig.scripts.json scripts/generate-labels.ts",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@qudtlib/allunits": "^7.1.0",
    "@qudtlib/core": "^7.1.0"
  },
  "devDependencies": {
    "@types/n3": "^1.21.0",
    "@types/node": "^20.0.0",
    "n3": "^1.17.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
